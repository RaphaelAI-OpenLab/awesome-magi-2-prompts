{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MAGI-2 prompt collection data",
  "description": "Single source of truth for MAGI-2 & MAGI-2-preview cases. Drafts may keep empty values; published entries are enforced by scripts/validate.py.",
  "type": "array",
  "items": { "$ref": "#/$defs/prompt" },
  "$defs": {
    "localized": {
      "type": "object",
      "required": ["en", "zh-CN"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string" },
        "zh-CN": { "type": "string" }
      }
    },
    "optionalString": { "type": ["string", "null"] },
    "prompt": {
      "type": "object",
      "required": [
        "id",
        "status",
        "title",
        "summary",
        "category",
        "tags",
        "origin",
        "prompt_status",
        "prompt_language",
        "short_prompt",
        "structured_prompt",
        "omni_references",
        "model",
        "parameters",
        "preview",
        "video_url",
        "source",
        "verification",
        "rights",
        "added_at",
        "featured",
        "links",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*)?$" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "title": { "$ref": "#/$defs/localized" },
        "summary": { "$ref": "#/$defs/localized" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "origin": { "type": "string", "enum": ["original", "official", "community"] },
        "prompt_status": { "type": "string", "enum": ["public", "not-public", "unverified"] },
        "prompt_language": { "type": "string" },
        "short_prompt": { "type": "string" },
        "structured_prompt": { "type": ["object", "string", "null"] },
        "omni_references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "path", "url", "description"],
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string", "enum": ["image", "video", "audio"] },
              "path": { "type": "string" },
              "url": { "$ref": "#/$defs/optionalString" },
              "description": { "$ref": "#/$defs/localized" }
            }
          }
        },
        "model": {
          "type": "object",
          "required": ["family", "variant", "api_model_id"],
          "additionalProperties": false,
          "properties": {
            "family": { "type": ["string", "null"] },
            "variant": { "type": "string", "enum": ["flagship", "preview", "unspecified"] },
            "api_model_id": { "$ref": "#/$defs/optionalString" }
          }
        },
        "parameters": {
          "type": "object",
          "required": ["task_type", "duration_sec", "fps", "resolution", "aspect_ratio", "has_audio", "audio_mode"],
          "additionalProperties": false,
          "properties": {
            "task_type": { "type": "string", "enum": ["t2v", "i2v", "omni-ref"] },
            "duration_sec": { "type": ["number", "null"] },
            "fps": { "type": ["integer", "null"] },
            "resolution": { "$ref": "#/$defs/optionalString" },
            "aspect_ratio": { "$ref": "#/$defs/optionalString" },
            "has_audio": { "type": "boolean" },
            "audio_mode": {
              "type": "string",
              "enum": ["dialogue", "sfx", "music", "mixed", "silent", "unspecified"]
            }
          }
        },
        "preview": {
          "type": "object",
          "required": ["path", "alt"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string" },
            "alt": { "$ref": "#/$defs/localized" }
          }
        },
        "video_url": { "$ref": "#/$defs/optionalString" },
        "source": {
          "type": "object",
          "required": ["url", "author", "author_url", "platform", "published_at"],
          "additionalProperties": false,
          "properties": {
            "url": { "$ref": "#/$defs/optionalString" },
            "author": { "type": "string" },
            "author_url": { "$ref": "#/$defs/optionalString" },
            "platform": { "type": "string" },
            "published_at": { "$ref": "#/$defs/optionalString" }
          }
        },
        "verification": {
          "type": "object",
          "required": ["status", "tested_at", "tested_on", "notes"],
          "additionalProperties": false,
          "properties": {
            "status": { "type": "string", "enum": ["source-only", "tested"] },
            "tested_at": { "$ref": "#/$defs/optionalString" },
            "tested_on": { "type": "string" },
            "notes": { "$ref": "#/$defs/localized" }
          }
        },
        "rights": {
          "type": "object",
          "required": ["prompt", "preview", "video", "credit", "license_url"],
          "additionalProperties": false,
          "properties": {
            "prompt": { "type": "string", "enum": ["own", "permission", "licensed", "source-attributed", "unknown"] },
            "preview": { "type": "string", "enum": ["own", "permission", "licensed", "source-attributed", "link-only", "unknown"] },
            "video": { "type": "string", "enum": ["own", "permission", "licensed", "source-attributed", "link-only", "unknown"] },
            "credit": { "type": "string" },
            "license_url": { "$ref": "#/$defs/optionalString" }
          }
        },
        "added_at": { "$ref": "#/$defs/optionalString" },
        "featured": { "type": "boolean" },
        "links": {
          "type": "object",
          "required": ["case_detail_url", "generate_url", "generate_url_verified_at"],
          "additionalProperties": false,
          "properties": {
            "case_detail_url": { "$ref": "#/$defs/optionalString" },
            "generate_url": { "$ref": "#/$defs/optionalString" },
            "generate_url_verified_at": { "$ref": "#/$defs/optionalString" }
          }
        },
        "notes": { "$ref": "#/$defs/localized" }
      }
    }
  }
}
